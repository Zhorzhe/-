# Копирайте като .env и попълнете, после: npm start

PORT=3000
# Брой обратни проксита (nginx, Cloudflare) пред приложението
TRUST_PROXY=1

# База данни (SQLite файл) и папка за писма, когато няма SMTP
DB_PATH=./data/tickets.db
OUTBOX_DIR=./data/outbox

# Дълъг случаен низ, напр. от: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# demo = картите не се таксуват реално; off = само банков превод
PAYMENT_MODE=demo

BANK_RECIPIENT=
BANK_IBAN=
BANK_NAME=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Международен панаир Пловдив <tickets@example.bg>
MAIL_REPLY_TO=
